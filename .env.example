# Supabase PostgreSQL — copie do painel do Supabase (Connection Pooling, porta 6543)
DATABASE_URL="postgresql://postgres.xxxxx:senha@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL — conexão direta (porta 5432), necessária para migrations
DIRECT_URL="postgresql://postgres.xxxxx:senha@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

NEXTAUTH_SECRET="troque-por-uma-string-aleatoria-longa"
NEXTAUTH_URL="https://seudominio.com.br"

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:seu-email@dominio.com.br"

# ---------------------------------------------------------------------------
# Para rodar via Docker localmente (docker compose up), não use este arquivo:
# as variáveis do stack local (Postgres em container, sem SSL) já estão
# definidas em .env.docker.
# ---------------------------------------------------------------------------
