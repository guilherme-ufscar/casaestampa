generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VENDEDOR
  ADMIN
  INSTALADOR
}

enum StatusOrcamento {
  orcamento_enviado
  aguardando_aprovacao
  aprovado
  em_producao
  pronto
  instalado
  finalizado
}

enum ModeloCortina {
  prega_macho
  prega_femea
  prega_americana
  prega_franzida
  prega_reta
  wave
  soft_wave
  varao
}

enum TipoAbertura {
  INTEIRA
  CENTRAL
}

enum TipoTrilho {
  trilho_suico
  varao
}

enum TipoTecido {
  PRINCIPAL
  BLACKOUT
  DECORACAO
}

model User {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senha        String
  role         Role     @default(VENDEDOR)
  comissao     Decimal? @db.Decimal(5, 2)
  ativo        Boolean  @default(true)
  instaladorId String?
  soAgenda     Boolean  @default(false)
  createdAt    DateTime @default(now())

  orcamentos        Orcamento[]
  logsHistorico     LogHistorico[]
  pushSubscriptions PushSubscription[]
  eventos           EventoAgenda[]
  instalador        Instalador?        @relation(fields: [instaladorId], references: [id])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  endereco  String?
  bairro    String?
  telefone  String?
  email     String?
  arquiteto String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orcamentos Orcamento[]
}

model Tecido {
  id            String     @id @default(cuid())
  nome          String
  larguraMaxima Decimal    @db.Decimal(5, 2)
  valorMetro    Decimal    @db.Decimal(10, 2)
  tipo          TipoTecido
  categoria     String?
  ativo         Boolean    @default(true)
  favorito      Boolean    @default(false)

  ambientes AmbienteOrcamento[] @relation("TecidoPrincipal")
  blackouts AmbienteOrcamento[] @relation("TecidoBlackout")
}

model TrilhoVarao {
  id            String  @id @default(cuid())
  nome          String
  valorUnitario Decimal @db.Decimal(10, 2)
  ativo         Boolean @default(true)

  ambientes AmbienteOrcamento[]
}

model ConfiguracaoCalculo {
  id    String @id @default(cuid())
  chave String @unique
  valor String
}

model Orcamento {
  id              String          @id @default(cuid())
  numero          Int             @default(autoincrement())
  clienteId       String?
  vendedorId      String
  status          StatusOrcamento @default(orcamento_enviado)
  precoFinalTotal Decimal?        @db.Decimal(10, 2)
  token           String?         @unique
  tokenExpiresAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  cliente  Cliente? @relation(fields: [clienteId], references: [id])
  vendedor User     @relation(fields: [vendedorId], references: [id])

  ambientes          AmbienteOrcamento[]
  ambientesPapel     AmbientePapelOrcamento[]
  ambientesPersiana  AmbientePersianaOrcamento[]
  ambientesPiso      AmbientePisoOrcamento[]
  logsHistorico      LogHistorico[]
  fotos              FotoOrcamento[]
}

model FotoOrcamento {
  id           String   @id @default(cuid())
  orcamentoId  String
  nomeAmbiente String?
  imagem       String   @db.Text  // base64 da imagem anotada
  observacao   String?
  createdAt    DateTime @default(now())

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
}

model Instalador {
  id        String  @id @default(cuid())
  nome      String
  telefone  String?
  ativo     Boolean @default(true)

  usuarios  User[]
  ambientes AmbienteOrcamento[]
  eventos   EventoAgenda[]
}

model AmbienteOrcamento {
  id                    String        @id @default(cuid())
  orcamentoId           String
  nomeAmbiente          String
  largura               Decimal       @db.Decimal(8, 2)
  altura                Decimal       @db.Decimal(8, 2)
  modeloCortina         ModeloCortina
  tipoAbertura          TipoAbertura  @default(INTEIRA)
  tipoAberturaBlackout  TipoAbertura?
  trilhoTipo            TipoTrilho    @default(trilho_suico)
  trilhoVaraoId         String?
  tecidoId              String
  blackoutId            String?
  bainhaDesejada        Decimal?      @db.Decimal(5, 2)
  tecidoExtra           Boolean       @default(false)
  blackoutExtra         Boolean       @default(false)
  instalacao            Boolean       @default(false)
  instaladorId          String?
  trilhoAcessoriosValor Decimal?      @db.Decimal(10, 2)
  outrosValor           Decimal?      @db.Decimal(10, 2)
  observacoes           String?
  quantidadeTecido      Decimal?      @db.Decimal(8, 2)
  quantidadeBlackout    Decimal?      @db.Decimal(8, 2)
  custoConfeccao        Decimal?      @db.Decimal(10, 2)
  custoInstalacao       Decimal?      @db.Decimal(10, 2)
  custoTotal            Decimal?      @db.Decimal(10, 2)
  precoFinalVenda       Decimal?      @db.Decimal(10, 2)

  orcamento   Orcamento    @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  tecido      Tecido       @relation("TecidoPrincipal", fields: [tecidoId], references: [id])
  blackout    Tecido?      @relation("TecidoBlackout", fields: [blackoutId], references: [id])
  trilhoVarao TrilhoVarao? @relation(fields: [trilhoVaraoId], references: [id])
  instalador  Instalador?  @relation(fields: [instaladorId], references: [id])
}

model FornecedorCadastro {
  id           String   @id @default(cuid())
  nomeEmpresa  String
  vendedor     String?
  telefone     String?
  email        String?
  endereco     String?
  contaBancaria String?
  pix          String?
  observacoes  String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LogHistorico {
  id          String   @id @default(cuid())
  orcamentoId String
  usuarioId   String
  acao        String
  detalhes    Json?
  createdAt   DateTime @default(now())

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  usuario   User      @relation(fields: [usuarioId], references: [id])
}

model PapelParede {
  id         String  @id @default(cuid())
  album      String
  referencia String?
  dimensao   String
  valorRolo  Decimal @db.Decimal(10, 2)
  categoria  String?
  ativo      Boolean @default(true)

  ambientes AmbientePapelOrcamento[]
}

model AmbientePapelOrcamento {
  id                 String   @id @default(cuid())
  orcamentoId        String
  nomeAmbiente       String
  papelId            String
  referenciaDigitada String?
  medicoes           Json
  metrosQuadrados    Decimal? @db.Decimal(10, 2)
  quantidadeRolos    Int?
  custoTotal         Decimal? @db.Decimal(10, 2)
  custoInstalacao    Decimal? @db.Decimal(10, 2)
  instalacao         Boolean  @default(false)
  precoFinalVenda    Decimal? @db.Decimal(10, 2)
  observacoes        String?

  orcamento Orcamento   @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  papel     PapelParede @relation(fields: [papelId], references: [id])
}

// ─── Persianas ────────────────────────────────────────────────────────────────

model Persiana {
  id            String   @id @default(cuid())
  fornecedor    String   // 'GABRIEL' | 'RIOFLEX' | 'AMORIM'
  tipo          String   // 'ROLO' | 'ROMANA' | 'PAINEL_SEM_HASTES' | 'PAINEL_COM_HASTES' | 'HORIZONTAL_16' | 'HORIZONTAL_25' | 'HORIZONTAL_50'
  colecao       String
  modelo        String
  codigo        String?
  larguraMaxima Decimal? @db.Decimal(6, 2)
  valorM2       Decimal  @db.Decimal(10, 2)
  minM2         Decimal  @default(1.50) @db.Decimal(5, 2)
  observacao    String?
  ativo         Boolean  @default(true)

  ambientes AmbientePersianaOrcamento[]
}

model AcessorioPersiana {
  id         String  @id @default(cuid())
  fornecedor String  // 'GABRIEL' | 'RIOFLEX' | 'AMORIM'
  tipo       String  // 'BANDO' | 'GUIA_LATERAL' | 'GUIA_BASE'
  nome       String
  valorMetro Decimal @db.Decimal(10, 2)
  observacao String?
  ativo      Boolean @default(true)
}

model MotorPersiana {
  id         String   @id @default(cuid())
  fornecedor String
  nome       String
  marca      String?
  valor      Decimal  @db.Decimal(10, 2)
  larguraMax Decimal? @db.Decimal(6, 2)
  cargaMaxKg Decimal? @db.Decimal(6, 2)
  observacao String?
  ativo      Boolean  @default(true)
}

model ControleRemotoPersiana {
  id         String  @id @default(cuid())
  fornecedor String
  nome       String
  canais     Int?
  valor      Decimal @db.Decimal(10, 2)
  ativo      Boolean @default(true)
}

// ─── Pisos (Laminado / Vinílico — Tabela BADIA) ─────────────────────────────────

model ProdutoPiso {
  id         String   @id @default(cuid())
  categoria  String   // LAMINADO | VINILICO | MANTA | RODAPE_LAMINADO | RODAPE_VINILICO | PERFIL | COLA | MASSA | CHAPA | PREGO | OUTROS
  fabricante String?
  modelo     String
  unidade    String   // M2 | PC | GALAO | SACO | METRO | PCT
  valor      Decimal  @db.Decimal(10, 2)
  medidaPeca Decimal? @db.Decimal(6, 2) // comprimento padrão da peça (ex: 2.10)
  rendimento Decimal? @db.Decimal(6, 2) // m² por unidade (cola/massa)
  observacao String?
  ativo      Boolean  @default(true)

  ambientes AmbientePisoOrcamento[]
}

model AmbientePisoOrcamento {
  id              String   @id @default(cuid())
  orcamentoId     String
  nomeAmbiente    String
  tipoPiso        String   // LAMINADO | VINILICO
  fabricante      String?
  pisoId          String?
  pisoModelo      String
  areaTotalBruta  Decimal  @db.Decimal(10, 2)
  areaComPerda    Decimal  @db.Decimal(10, 2)
  rodapeNome      String?
  frete           Decimal  @default(190) @db.Decimal(10, 2)
  custoTotal      Decimal  @db.Decimal(10, 2)
  precoFinalVenda Decimal  @db.Decimal(10, 2)
  dados           Json
  observacoes     String?

  orcamento Orcamento    @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  piso      ProdutoPiso? @relation(fields: [pisoId], references: [id])
}

model AmbientePersianaOrcamento {
  id           String @id @default(cuid())
  orcamentoId  String
  nomeAmbiente String

  // Persiana selecionada (snapshot + FK)
  persianaId    String
  fornecedor    String
  tipo          String
  colecao       String
  modelo        String
  largura       Decimal @db.Decimal(6, 2)
  altura        Decimal @db.Decimal(6, 2)
  quantidade    Int     @default(1)
  lado          String? // 'lado_a_lado' | 'transpassada'
  acionamento   String  // 'manual' | 'motorizada'
  instalacaoLocal String?  // 'teto' | 'parede' | 'dentro_vao' | 'fora_vao'
  trilhoLargura Decimal? @db.Decimal(6, 2)

  // Acessórios (IDs para referência + valores snapshot)
  bandoId           String?
  bandoNome         String?
  bandoValorMetro   Decimal? @db.Decimal(10, 2)
  bandoLado         String?

  guiaLateralId           String?
  guiaLateralNome         String?
  guiaLateralValorMetro   Decimal? @db.Decimal(10, 2)
  guiaLateralFator        Int?

  guiaBaseId          String?
  guiaBaseNome        String?
  guiaBaseValorMetro  Decimal? @db.Decimal(10, 2)

  motorId    String?
  motorNome  String?
  motorValor Decimal? @db.Decimal(10, 2)

  controleRemotoId    String?
  controleRemotoNome  String?
  controleRemotoValor Decimal? @db.Decimal(10, 2)

  // Resultado calculado
  m2Calculado          Decimal @db.Decimal(10, 4)
  m2Cobrado            Decimal @db.Decimal(10, 4)
  custoPersiana        Decimal @db.Decimal(10, 2)
  custoBando           Decimal @default(0) @db.Decimal(10, 2)
  custoGuiaLateral     Decimal @default(0) @db.Decimal(10, 2)
  custoGuiaBase        Decimal @default(0) @db.Decimal(10, 2)
  custoMotor           Decimal @default(0) @db.Decimal(10, 2)
  custoControle        Decimal @default(0) @db.Decimal(10, 2)
  custoInstalacaoMotor Decimal @default(0) @db.Decimal(10, 2)
  custoInstalacao      Decimal @default(0) @db.Decimal(10, 2)
  custoTotal           Decimal @db.Decimal(10, 2)
  precoFinalVenda      Decimal @db.Decimal(10, 2)
  instalacao           Boolean @default(true)
  observacoes          String?

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  persiana  Persiana  @relation(fields: [persianaId], references: [id])
}

model EventoAgenda {
  id           String    @id @default(cuid())
  titulo       String
  descricao    String?
  inicio       DateTime
  fim          DateTime?
  diaInteiro   Boolean   @default(false)
  tipo         String    @default("visita") // visita, instalacao, entrega, outro
  cor          String    @default("#C9A84C")
  usuarioId    String    // dono do evento
  orcamentoId  String?   // opcional
  instaladorId String?   // se for instalação
  createdAt    DateTime  @default(now())

  usuario    User       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instalador Instalador? @relation(fields: [instaladorId], references: [id])
}
