# Copie para .env.docker e ajuste os valores antes de rodar `docker compose up`.
# Este arquivo alimenta os serviços postgres, migrate e nextjs do docker-compose.yml.

# --- Postgres (container interno, sem porta exposta ao host) ---
POSTGRES_USER=casaestampa
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=casaestampa

# --- App (lib/prisma.ts e prisma.config.ts) ---
DATABASE_URL=postgresql://casaestampa:troque-esta-senha@postgres:5432/casaestampa
DIRECT_URL=postgresql://casaestampa:troque-esta-senha@postgres:5432/casaestampa
DATABASE_SSL=false

# --- NextAuth ---
NEXTAUTH_SECRET=troque-por-uma-string-aleatoria-longa
NEXTAUTH_URL=http://localhost:3000

# --- Web Push (gere seu próprio par de chaves VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:seu-email@dominio.com.br

# --- Import de clientes (scripts/importar-clientes.mjs) ---
# Nome do arquivo .xlsx na raiz do projeto (não versionado — contém dados de clientes)
CLIENTES_XLSX=Cadastro de Clientes (1).xlsx
